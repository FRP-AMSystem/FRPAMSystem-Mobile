<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    android:orientation="vertical"
    tools:context=".ui.schedule.ScheduleActivity">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvMonthYear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="August 2026" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToday"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_today"
            android:textAllCaps="false"
            android:textColor="@color/forest_green" />

        <ImageButton
            android:id="@+id/btnPrevMonth"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/schedule_prev_month"
            android:src="@drawable/ic_chevron_left" />

        <ImageButton
            android:id="@+id/btnNextMonth"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/schedule_next_month"
            android:rotation="180"
            android:src="@drawable/ic_chevron_left" />
    </LinearLayout>

    <!-- Weekday headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <TextView style="@style/CalendarWeekdayLabel" android:text="@string/weekday_mon" />
        <TextView style="@style/CalendarWeekdayLabel" android:text="@string/weekday_tue" />
        <TextView style="@style/CalendarWeekdayLabel" android:text="@string/weekday_wed" />
        <TextView style="@style/CalendarWeekdayLabel" android:text="@string/weekday_thu" />
        <TextView style="@style/CalendarWeekdayLabel" android:text="@string/weekday_fri" />
        <TextView style="@style/CalendarWeekdayLabel" android:text="@string/weekday_sat" />
        <TextView style="@style/CalendarWeekdayLabel" android:text="@string/weekday_sun" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_input" />

    <!-- Month grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCalendar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/card_white"
        android:clipToPadding="false"
        tools:listitem="@layout/item_calendar_day" />
</LinearLayout>
